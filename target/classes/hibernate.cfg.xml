<hibernate-configuration>
    <session-factory>
        <property name="hibernate.dialect">org.hibernate.community.dialect.SQLiteDialect</property>
        <property name="hibernate.connection.driver_class">org.sqlite.JDBC</property>
        <property name="hibernate.connection.url">jdbc:sqlite:privsys.db</property>
        <property name="hibernate.hbm2ddl.auto">update</property>
        <property name="hibernate.show_sql">true</property>
        <mapping class="pt.unl.fct.di.syspriv.entities.Employee"/>
        <mapping class="pt.unl.fct.di.syspriv.entities.Patient"/>
        <mapping class="pt.unl.fct.di.syspriv.entities.Appointment"/>
        <mapping class="pt.unl.fct.di.syspriv.entities.Payment"/>
        <mapping class="pt.unl.fct.di.syspriv.entities.ConsentRecord"/>
        <mapping class="pt.unl.fct.di.syspriv.entities.GDPRRequest"/>
    </session-factory>
</hibernate-configuration>
