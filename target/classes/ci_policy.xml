<?xml version="1.0" encoding="UTF-8"?>
<PolicySet xmlns="urn:oasis:names:tc:xacml:3.0:core:schema:wd-17"
           PolicySetId="HospitalPolicySet"
           Version="1.0"
           PolicyCombiningAlgId="urn:oasis:names:tc:xacml:1.0:policy-combining-algorithm:first-applicable">
    <Target/>

    <Policy PolicyId="PatientOwnData" Version="1.0"
            RuleCombiningAlgId="urn:oasis:names:tc:xacml:1.0:rule-combining-algorithm:first-applicable">
        <Description>
            This policy implements the first rule: Patients can only access their own data. The
            target checks to ensure that the access-subject's "role" attribute is equal to the
            string "Patient." If it is, the rule defined below will apply.
        </Description>
        <Target>
            <AnyOf>
                <AllOf>
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">Patient</AttributeValue>
                        <AttributeDesignator
                                Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject"
                                AttributeId="role"
                                DataType="http://www.w3.org/2001/XMLSchema#string"
                                MustBePresent="false"/>
                    </Match>
                </AllOf>
            </AnyOf>
        </Target>
        <Rule RuleId="PatientOwnDataRule" Effect="Permit">
            <Description>
                The rule itself checks to see if the access subject has the same ID as the
                resource they are accessing. Given that both the access subject and the resource id
                need to be accessed as an AttributeDesignator (since they are passed as part of the
                request) which is allways interpreted as a bag, the rule checks for their equality
                using the string-set-equals function instead of the string-equals function.
            </Description>
            <Condition>
                <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-set-equals">
                    <AttributeDesignator
                            Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject"
                            AttributeId="id"
                            DataType="http://www.w3.org/2001/XMLSchema#string"
                            MustBePresent="false"/>
                    <AttributeDesignator
                            Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource"
                            AttributeId="id"
                            DataType="http://www.w3.org/2001/XMLSchema#string"
                            MustBePresent="false"/>
                </Apply>
            </Condition>
        </Rule>
    </Policy>

    <Policy PolicyId="EmployeeOwnData" Version="1.0"
            RuleCombiningAlgId="urn:oasis:names:tc:xacml:1.0:rule-combining-algorithm:first-applicable">
        <Description>
            This policy ensures that employees can only access their own data. The Target checks to
            ensure that the access subject is either a Clerk, an Accountaint, a Doctor, a Nurse, or
            an IT Admin. Since these are all of the possible employee roles, this rule will apply to
            any epmployee that accesses employee data.
        </Description>

        <!-- exercicio 1.1: basta UM dos AllOf ser verdadeiro -->
        <Target>
            <AnyOf>

                <!-- role == Clerk -->
                <AllOf>
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">

                        <!-- Valor com que queremos comparar -->
                        <AttributeValue
                                DataType="http://www.w3.org/2001/XMLSchema#string">Clerk</AttributeValue>

                        <!-- Vai buscar o atributo "role" do utilizador -->
                        <AttributeDesignator
                                Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject"
                                AttributeId="role"
                                DataType="http://www.w3.org/2001/XMLSchema#string"
                                MustBePresent="false"/>

                    </Match>
                </AllOf>

                <!-- OR role == Accountant -->
                <AllOf>
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">

                        <AttributeValue
                                DataType="http://www.w3.org/2001/XMLSchema#string">Accountant</AttributeValue>

                        <AttributeDesignator
                                Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject"
                                AttributeId="role"
                                DataType="http://www.w3.org/2001/XMLSchema#string"
                                MustBePresent="false"/>

                    </Match>
                </AllOf>

                <!-- OR role == Doctor -->
                <AllOf>
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">

                        <AttributeValue
                                DataType="http://www.w3.org/2001/XMLSchema#string">Doctor</AttributeValue>

                        <AttributeDesignator
                                Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject"
                                AttributeId="role"
                                DataType="http://www.w3.org/2001/XMLSchema#string"
                                MustBePresent="false"/>

                    </Match>
                </AllOf>

                <!-- OR role == Nurse -->
                <AllOf>
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">

                        <AttributeValue
                                DataType="http://www.w3.org/2001/XMLSchema#string">Nurse</AttributeValue>

                        <AttributeDesignator
                                Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject"
                                AttributeId="role"
                                DataType="http://www.w3.org/2001/XMLSchema#string"
                                MustBePresent="false"/>

                    </Match>
                </AllOf>

                <!-- OR role == ITAdmin -->
                <AllOf>
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">

                        <AttributeValue
                                DataType="http://www.w3.org/2001/XMLSchema#string">ITAdmin</AttributeValue>

                        <AttributeDesignator
                                Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject"
                                AttributeId="role"
                                DataType="http://www.w3.org/2001/XMLSchema#string"
                                MustBePresent="false"/>

                    </Match>
                </AllOf>

            </AnyOf>
        </Target>

        <Rule RuleId="EmployeeOwnDataRule" Effect="Permit">
            <Description>
                The rule itself checks to see if the access subject has the same ID as the
                resource they are accessing. Given that both the access subject and the resource id
                need to be accessed as an AttributeDesignator (since they are passed as part of the
                request) which is allways interpreted as a bag, the rule checks for their equality
                using the string-set-equals function instead of the string-equals function.
            </Description>
            <Condition>

                <!-- exercicio 1.2 : -->
                <!-- subject.id == resource.id -->

                <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-set-equals">

                    <AttributeDesignator
                            Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject"
                            AttributeId="id"
                            DataType="http://www.w3.org/2001/XMLSchema#string"
                            MustBePresent="false"/>

                    <AttributeDesignator
                            Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource"
                            AttributeId="id"
                            DataType="http://www.w3.org/2001/XMLSchema#string"
                            MustBePresent="false"/>

                </Apply>

            </Condition>
        </Rule>
    </Policy>

    <Policy PolicyId="ClerkAppointmentData" Version="1.0"
            RuleCombiningAlgId="urn:oasis:names:tc:xacml:1.0:rule-combining-algorithm:first-applicable">
        <Description>
            This Policy implements rule 3: Clerks can only access Appointment Data for the purpose
            of scheduling and check-in. Our Target works by ensuring that the access-subject's role
            attribute is equal to the string literal "Clerk".
        </Description>
        <Target>
            <AnyOf>
                <AllOf>
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">Clerk</AttributeValue>
                        <AttributeDesignator
                                Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject"
                                AttributeId="role"
                                DataType="http://www.w3.org/2001/XMLSchema#string"
                                MustBePresent="false"/>
                    </Match>
                </AllOf>
            </AnyOf>
        </Target>
        <Rule RuleId="ClerkRule" Effect="Permit">
            <Description>
                This rule is the first rule to use conditional logic operators such as AND and OR.
                Specifically, this rule can be written as "Resource is AppointmentData AND (Context
                is Scheduling OR Context is Check-in. Note that we implement the logical operator
                AND by calling a function in an Apply block that wraps all of the conditions. Though
                our logic does include an OR in it, instead of implementing OR logic we do a trick
                where we check if the Context is a subset of the set {Scheduling, Check-in}. So long
                as only one context is passed, this is logically equivalent.
            </Description>
            <Condition>
                <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:and">

                    <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-equal">

                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">AppointmentData</AttributeValue>

                        <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-one-and-only">
                            <AttributeDesignator
                                    Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource"
                                    AttributeId="resource-type"
                                    DataType="http://www.w3.org/2001/XMLSchema#string"
                                    MustBePresent="false"/>
                        </Apply>

                    </Apply>

                    <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-subset">

                        <AttributeDesignator
                                Category="urn:oasis:names:tc:xacml:3.0:attribute-category:environment"
                                AttributeId="context"
                                DataType="http://www.w3.org/2001/XMLSchema#string"
                                MustBePresent="false"/>

                        <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-bag">

                            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">Scheduling</AttributeValue>

                            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">Check-in</AttributeValue>

                        </Apply>

                    </Apply>

                </Apply>
            </Condition>
        </Rule>
    </Policy>

    <Policy PolicyId="AccountantBillingData" Version="1.0"
            RuleCombiningAlgId="urn:oasis:names:tc:xacml:1.0:rule-combining-algorithm:first-applicable">
        <Description>
            This Policy implements rule 4: Accountants can only access Payment Data or Employee Data
            for the purposes of Billing and Payment. The target applies to accountants, and this is
            checked by seeing if the access subject's role is equal to the string "Accountant".
        </Description>
        <Target>

            <!-- exercise 1.3 :role == Accountant -->

            <AnyOf>
                <AllOf>

                    <!-- Verifica se o role do utilizador é Accountant -->
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">

                        <!-- Valor que queremos comparar -->
                        <AttributeValue
                                DataType="http://www.w3.org/2001/XMLSchema#string">Accountant</AttributeValue>

                        <!-- Vai buscar o atributo role de quem está a fazer o pedido -->
                        <AttributeDesignator
                                Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject"
                                AttributeId="role"
                                DataType="http://www.w3.org/2001/XMLSchema#string"
                                MustBePresent="false"/>

                    </Match>

                </AllOf>
            </AnyOf>

        </Target>

        <Rule RuleId="AccountantRule" Effect="Permit">
            <Description>
                Here we use the logical AND operator between two conditions. The first condition
                checks to see if the resource we are accessing is a subset of {PaymentData,
                EmployeeData}. Assuming we receive only one resource, this is equivalent to the
                logical expression Resource is PaymentData OR Resource is EmployeeData. We then
                logically AND this with the string comparison between the string literal
                "BillingAndPayment" and the context attribute.
            </Description>
            <Condition>

                <!-- exercise 1.4 -->

                <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:and">

                    <!-- resource-type is PaymentData OR EmployeeData -->
                    <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-subset">

                        <!-- em vez de fazeres um OR, verificas se o valor está dentro do conjunto permitido -->

                        <AttributeDesignator
                                Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource"
                                AttributeId="resource-type"
                                DataType="http://www.w3.org/2001/XMLSchema#string"
                                MustBePresent="false"/>

                        <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-bag">

                            <AttributeValue
                                    DataType="http://www.w3.org/2001/XMLSchema#string">PaymentData</AttributeValue>

                            <AttributeValue
                                    DataType="http://www.w3.org/2001/XMLSchema#string">EmployeeData</AttributeValue>

                        </Apply>

                    </Apply>

                    <!-- context == BillingAndPayment -->
                    <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-equal">

                        <AttributeValue
                                DataType="http://www.w3.org/2001/XMLSchema#string">BillingAndPayment</AttributeValue>

                        <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-one-and-only">

                            <AttributeDesignator
                                    Category="urn:oasis:names:tc:xacml:3.0:attribute-category:environment"
                                    AttributeId="context"
                                    DataType="http://www.w3.org/2001/XMLSchema#string"
                                    MustBePresent="false"/>

                        </Apply>

                    </Apply>

                </Apply>

            </Condition>
        </Rule>
    </Policy>

    <Policy PolicyId="DoctorOwnPatientsNonEmergency" Version="1.0"
            RuleCombiningAlgId="urn:oasis:names:tc:xacml:1.0:rule-combining-algorithm:first-applicable">
        <Description>
            This Policy implements rule 5. Our target checks if the access subject's role is either
            the string literal "Doctor" or the string literal "Nurse". Note that a logical OR is not
            needed here, since the AnyOf and AllOf tags already handle this logic.
        </Description>
        <Target>

            <!-- exercise 1.5 -->

            <AnyOf>

                <!-- role == Doctor -->
                <AllOf>
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">

                        <AttributeValue
                                DataType="http://www.w3.org/2001/XMLSchema#string">Doctor</AttributeValue>

                        <!-- Vai buscar o role de quem está a fazer o pedido -->
                        <AttributeDesignator
                                Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject"
                                AttributeId="role"
                                DataType="http://www.w3.org/2001/XMLSchema#string"
                                MustBePresent="false"/>

                    </Match>
                </AllOf>

                <!-- OR role == Nurse -->
                <AllOf>
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">

                        <AttributeValue
                                DataType="http://www.w3.org/2001/XMLSchema#string">Nurse</AttributeValue>

                        <AttributeDesignator
                                Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject"
                                AttributeId="role"
                                DataType="http://www.w3.org/2001/XMLSchema#string"
                                MustBePresent="false"/>

                    </Match>
                </AllOf>

            </AnyOf>

        </Target>

        <Rule RuleId="DoctorOwnPatientRule" Effect="Permit">
            <Description>
                This rule is implemented via a simple comparison between the access subject's ID and
                the patient's Doctor ID and a logical AND asserting that the resource being accessed
                is patient data.
            </Description>
            <Condition>

                <!-- exercise 1.6 -->
                <!-- pretende verificar que o médico/enfermeiro
                que está a pedir acesso é o profissional associado
                aquele paciente e que os dados acedidos são mesmo PatientData -->

                <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:and">

                    <!-- subject.id == patient's doctor-id -->
                    <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-set-equals">

                        <AttributeDesignator
                                Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject"
                                AttributeId="id"
                                DataType="http://www.w3.org/2001/XMLSchema#string"
                                MustBePresent="false"/>

                        <AttributeDesignator
                                Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource"
                                AttributeId="doctor-id"
                                DataType="http://www.w3.org/2001/XMLSchema#string"
                                MustBePresent="false"/>

                    </Apply>

                    <!-- resource-type == PatientData -->
                    <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-equal">

                        <AttributeValue
                                DataType="http://www.w3.org/2001/XMLSchema#string">PatientData</AttributeValue>

                        <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-one-and-only">

                            <AttributeDesignator
                                    Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource"
                                    AttributeId="resource-type"
                                    DataType="http://www.w3.org/2001/XMLSchema#string"
                                    MustBePresent="false"/>

                        </Apply>

                    </Apply>

                </Apply>

            </Condition>
        </Rule>
    </Policy>

    <Policy PolicyId="DoctorEmergency" Version="1.0"
            RuleCombiningAlgId="urn:oasis:names:tc:xacml:1.0:rule-combining-algorithm:first-applicable">
        <Description>
            This Policy implements rule 6, which allows doctors and nurses to access any patient
            data in an emergency. This works by checking that the access subject's role is Doctor
            and the context is Emergency, or the access subject's role is Nurse and the context is
            Emergency.
        </Description>

        <!-- exercise 1.7 -->
        <Target>
            <AnyOf>

                <!-- role == Doctor -->
                <AllOf>
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">

                        <AttributeValue
                                DataType="http://www.w3.org/2001/XMLSchema#string">Doctor</AttributeValue>

                        <AttributeDesignator
                                Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject"
                                AttributeId="role"
                                DataType="http://www.w3.org/2001/XMLSchema#string"
                                MustBePresent="false"/>

                    </Match>
                </AllOf>

                <!-- OR role == Nurse -->
                <AllOf>
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">

                        <AttributeValue
                                DataType="http://www.w3.org/2001/XMLSchema#string">Nurse</AttributeValue>

                        <AttributeDesignator
                                Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject"
                                AttributeId="role"
                                DataType="http://www.w3.org/2001/XMLSchema#string"
                                MustBePresent="false"/>

                    </Match>
                </AllOf>

            </AnyOf>
        </Target>

        <Rule RuleId="DoctorEmergencyRule" Effect="Permit">
            <Description>
                Given that we already checked the role in the target, here we need to check the
                context and ensure that the resource being accessed is PatientData.
            </Description>
            <Condition>

                <!-- exercise 1.8 -->

                <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:and">

                    <!-- context == Emergency -->
                    <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-equal">

                        <AttributeValue
                                DataType="http://www.w3.org/2001/XMLSchema#string">Emergency</AttributeValue>

                        <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-one-and-only">

                            <AttributeDesignator
                                    Category="urn:oasis:names:tc:xacml:3.0:attribute-category:environment"
                                    AttributeId="context"
                                    DataType="http://www.w3.org/2001/XMLSchema#string"
                                    MustBePresent="false"/>

                        </Apply>

                    </Apply>

                    <!-- resource-type == PatientData -->
                    <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-equal">

                        <AttributeValue
                                DataType="http://www.w3.org/2001/XMLSchema#string">PatientData</AttributeValue>

                        <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-one-and-only">

                            <AttributeDesignator
                                    Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource"
                                    AttributeId="resource-type"
                                    DataType="http://www.w3.org/2001/XMLSchema#string"
                                    MustBePresent="false"/>

                        </Apply>

                    </Apply>

                </Apply>

            </Condition>
        </Rule>
    </Policy>

    <Policy PolicyId="ITAdminEmergency" Version="1.0"
            RuleCombiningAlgId="urn:oasis:names:tc:xacml:1.0:rule-combining-algorithm:first-applicable">
        <Description>
            This Policy implements the rule IT Admins can access any data in an emergency. We can
            achieve this by checking if the role of the access subject is the ITAdmin. If this is
            the case, we can move on to the rule.
        </Description>
        <Target>

            <!-- exercise 1.9 -->

            <!-- os dois Match estão dentro do mesmo AllOf, portanto ambos têm de ser verdadeiros -->
            <AnyOf>
                <AllOf>

                    <!-- role == ITAdmin -->
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">

                        <AttributeValue
                                DataType="http://www.w3.org/2001/XMLSchema#string">ITAdmin</AttributeValue>

                        <AttributeDesignator
                                Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject"
                                AttributeId="role"
                                DataType="http://www.w3.org/2001/XMLSchema#string"
                                MustBePresent="false"/>

                    </Match>

                    <!-- context == Emergency -->
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">

                        <AttributeValue
                                DataType="http://www.w3.org/2001/XMLSchema#string">Emergency</AttributeValue>

                        <AttributeDesignator
                                Category="urn:oasis:names:tc:xacml:3.0:attribute-category:environment"
                                AttributeId="context"
                                DataType="http://www.w3.org/2001/XMLSchema#string"
                                MustBePresent="false"/>

                    </Match>

                </AllOf>
            </AnyOf>

        </Target>

        <!-- Hint: we can implement this rule just with the target section. no need for condition?-->
        <!-- exercise 1.10 -->
        <Rule RuleId="ITAdminEmergencyRule" Effect="Permit">
            <Description>Check if emergency.</Description>
        </Rule>
    </Policy>

    <Policy PolicyId="ITAdminHiring" Version="1.0"
            RuleCombiningAlgId="urn:oasis:names:tc:xacml:1.0:rule-combining-algorithm:first-applicable">
        <Description>
            This Policy implements the rule that outside of an emergency IT Admins can only access
            employee data for the purposes of hiring. To see if this rule should be applied, we
            check if the role of the access subject is "ITAdmin".
        </Description>
        <Target>

            <!-- exercise 1.11 -->

            <AnyOf>
                <AllOf>

                    <!-- role == ITAdmin -->
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">

                        <AttributeValue
                                DataType="http://www.w3.org/2001/XMLSchema#string">ITAdmin</AttributeValue>

                        <AttributeDesignator
                                Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject"
                                AttributeId="role"
                                DataType="http://www.w3.org/2001/XMLSchema#string"
                                MustBePresent="false"/>

                    </Match>

                </AllOf>
            </AnyOf>

        </Target>

        <Rule RuleId="ITAdminHiringRule" Effect="Permit">
            <Description>
                We check to see if the access should be permitted if Resource is EmployeeData AND
                Context is Hiring. This uses the same tricks as previous rules, so there is no need
                to recover old ground.
            </Description>
            <Condition>

                <!-- exercise 1.12 -->

                <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:and">

                    <!-- resource-type == EmployeeData -->
                    <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-equal">

                        <AttributeValue
                                DataType="http://www.w3.org/2001/XMLSchema#string">EmployeeData</AttributeValue>

                        <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-one-and-only">

                            <AttributeDesignator
                                    Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource"
                                    AttributeId="resource-type"
                                    DataType="http://www.w3.org/2001/XMLSchema#string"
                                    MustBePresent="false"/>

                        </Apply>

                    </Apply>

                    <!-- context == Hiring -->
                    <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-equal">

                        <AttributeValue
                                DataType="http://www.w3.org/2001/XMLSchema#string">Hiring</AttributeValue>

                        <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-one-and-only">

                            <AttributeDesignator
                                    Category="urn:oasis:names:tc:xacml:3.0:attribute-category:environment"
                                    AttributeId="context"
                                    DataType="http://www.w3.org/2001/XMLSchema#string"
                                    MustBePresent="false"/>

                        </Apply>

                    </Apply>

                </Apply>

            </Condition>
        </Rule>
    </Policy>

    <!-- Default - Deny -->
    <Policy PolicyId="DefaultDeny" Version="1.0"
            RuleCombiningAlgId="urn:oasis:names:tc:xacml:1.0:rule-combining-algorithm:first-applicable">
        <Description>
            By default, we deny the rest.
        </Description>
        <Target/>
        <Rule RuleId="DenyAllRule" Effect="Deny"/>
    </Policy>

</PolicySet>